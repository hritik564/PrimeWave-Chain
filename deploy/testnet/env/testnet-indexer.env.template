# PrimeWave Testnet — Indexer Environment Template
# TESTNET ONLY | Sprint PW-C14
# Copy to /etc/primewave/testnet-indexer.env and fill in values.
# NEVER commit this file with real values to Git.

# Chain connection
INDEXER_RPC_URL=https://rpc.primewave-testnet.example.com/ext/bc/__REPLACE_BLOCKCHAIN_ID__/rpc
INDEXER_WS_URL=wss://rpc.primewave-testnet.example.com/ext/bc/__REPLACE_BLOCKCHAIN_ID__/ws
INDEXER_CHAIN_ID=77777
INDEXER_NETWORK=testnet

# Database
INDEXER_DB_URL=postgresql://indexer:__REPLACE_DB_PASSWORD__@localhost:5432/primewave_testnet

# Contract addresses (filled by deploy-contracts.sh)
ADDR_FEE_DISTRIBUTOR=__REPLACE__
ADDR_VALIDATOR_FEE_VAULT=__REPLACE__
ADDR_DEV_TREASURY=__REPLACE__
ADDR_REWARD_VAULT=__REPLACE__
ADDR_VALIDATOR_REGISTRY=__REPLACE__
ADDR_EMERGENCY_MULTISIG=__REPLACE__
ADDR_TIMELOCK=__REPLACE__

# API
INDEXER_API_PORT=4000
INDEXER_API_HOST=127.0.0.1

# Limits
INDEXER_MAX_BLOCK_BATCH=50
INDEXER_POLL_INTERVAL_MS=2000
NODE_ENV=production
