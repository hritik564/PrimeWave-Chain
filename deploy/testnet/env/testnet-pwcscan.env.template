# PrimeWave Testnet — PWCScan Environment Template
# TESTNET ONLY | Sprint PW-C14 (updated: Chain ID 77)
# Copy to /etc/primewave/testnet-pwcscan.env and fill in values.
# NEVER commit this file with real values to Git.

# Indexer API base URL (internal to the host; nginx proxies /indexer-api/ publicly)
VITE_INDEXER_API_URL=/indexer-api

# Network label — displayed as orange "🧪 Testnet" badge in NavBar and homepage.
# MUST be "Testnet" for all testnet builds.
# DO NOT set to "Mainnet".
VITE_NETWORK_LABEL=Testnet

# Chain ID fallback — shown before the indexer responds.
# Chain ID 77 = PrimeWave Testnet
# Chain ID 73571 = PrimeWave Local Dev (do NOT use here)
VITE_CHAIN_ID=77

# Build target
NODE_ENV=production
