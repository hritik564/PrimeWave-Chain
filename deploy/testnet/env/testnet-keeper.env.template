# PrimeWave Testnet — Keeper Environment Template
# TESTNET ONLY | Sprint PW-C14
# Copy to /etc/primewave/testnet-keeper.env and fill in values.
# NEVER commit this file with real values to Git.

KEEPER_RPC_URL=https://rpc.primewave-testnet.example.com/ext/bc/__REPLACE_BLOCKCHAIN_ID__/rpc
KEEPER_CHAIN_ID=77
KEEPER_NETWORK=testnet

# Keeper signer — TESTNET KEY ONLY
# For testnet: software key acceptable
# For mainnet: hardware wallet REQUIRED
KEEPER_PRIVATE_KEY=__REPLACE_TESTNET_KEEPER_PRIVATE_KEY__

# Contract addresses
KEEPER_REGISTRY_ADDR=__REPLACE_VALIDATOR_REGISTRY_ADDRESS__
KEEPER_VAULT_ADDR=__REPLACE_VALIDATOR_FEE_VAULT_ADDRESS__

# State database (for restart recovery)
KEEPER_DB_URL=postgresql://keeper:__REPLACE_DB_PASSWORD__@localhost:5432/primewave_testnet_keeper

# Operational
KEEPER_POLL_INTERVAL_MS=30000
KEEPER_HEALTH_PORT=8080
KEEPER_MAX_RETRIES=5
KEEPER_RETRY_DELAY_MS=5000

NODE_ENV=production
LOG_LEVEL=info
