## PrimeWave Chain — Local Development Network Configuration
## ==========================================================
## ENVIRONMENT: LOCAL DEVELOPMENT ONLY
## NOT FOR TESTNET. NOT FOR MAINNET.
## ==========================================================
## This file contains non-secret configuration for the local dev network.
## DO NOT add private keys or production credentials to this file.
## DO NOT commit secrets to version control.

# Chain identity
PRIMEWAVE_CHAIN_NAME="primewavedev"
PRIMEWAVE_DEV_CHAIN_ID="73571"
PRIMEWAVE_TOKEN_SYMBOL="PW"
PRIMEWAVE_TOKEN_NAME="PrimeWave"

# Network
PRIMEWAVE_NODE_COUNT="3"
PRIMEWAVE_LOCAL_HOST="127.0.0.1"
PRIMEWAVE_RPC_PORT="9650"

# These are populated by start-local.sh after deployment:
# PRIMEWAVE_BLOCKCHAIN_ID=""     # P-Chain blockchain ID for this L1
# PRIMEWAVE_RPC_URL=""           # http://127.0.0.1:9650/ext/bc/<blockchainID>/rpc
# PRIMEWAVE_WS_URL=""            # ws://127.0.0.1:9650/ext/bc/<blockchainID>/ws
# PRIMEWAVE_RPC_URL_ALIAS=""     # Alias endpoint if available

# Block targets
PRIMEWAVE_TARGET_BLOCK_RATE="2"
PRIMEWAVE_GAS_LIMIT="30000000"

# MetaMask connection info (populated after deployment)
# Network Name: PrimeWave Dev
# RPC URL: see PRIMEWAVE_RPC_URL above
# Chain ID: 73571
# Currency Symbol: PW
# Block Explorer: (none for local dev)
