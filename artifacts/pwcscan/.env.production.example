# Build-time values for the existing PrimeWave Chain Replit project.
# Replit provides PORT at runtime; the Vite build command supplies PORT=5000.
BASE_PATH=/
VITE_DEFAULT_NETWORK=mainnet

# Keep all VITE_MAINNET_* RPC/indexer endpoint variables unset until the
# production gateways are verified and separately authorized. The app will
# display Mainnet as not connected and will not fabricate blockchain data.
