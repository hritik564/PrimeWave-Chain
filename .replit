modules = ["nodejs-24", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "LOCAL DEVELOPMENT ONLY"

[[workflows.workflow]]
name = "LOCAL DEVELOPMENT ONLY"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "PrimeWave Chain (LOCAL DEVELOPMENT ONLY)"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "PrimeWave Indexer (LOCAL DEVELOPMENT ONLY)"

[[workflows.workflow]]
name = "PrimeWave Chain (LOCAL DEVELOPMENT ONLY)"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/start-chain.sh"

[[workflows.workflow]]
name = "PrimeWave Indexer (LOCAL DEVELOPMENT ONLY)"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/start-indexer.sh"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
